<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Border
        Margin="8,0,8,8"
        Padding="6,2"
        Classes="card">
        <DockPanel Margin="4,2">
            <StackPanel
                Margin="{StaticResource MarginLr8}"
                VerticalAlignment="Center"
                DockPanel.Dock="Right">
                <TextBlock x:Name="txtSpeedProxyDisplay" HorizontalAlignment="Right" />
                <Border Margin="1" IsVisible="{Binding !EnableTun}" />
                <TextBlock
                    x:Name="txtSpeedDirectDisplay"
                    HorizontalAlignment="Right"
                    IsVisible="{Binding !EnableTun}" />
            </StackPanel>

            <StackPanel
                Margin="{StaticResource MarginLr8}"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="btnTun"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BtnTun_Click"
                    Theme="{DynamicResource BorderlessButton}"
                    ToolTip.Tip="{x:Static resx:ResUI.TbEnableTunAs}">
                    <Panel>
                        <Border
                            Padding="8,2"
                            Background="{DynamicResource SemiColorPrimaryLight}"
                            CornerRadius="8"
                            IsVisible="{Binding EnableTun}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource SemiColorSuccess}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SemiColorPrimary}"
                                    Text="TUN" />
                            </StackPanel>
                        </Border>
                        <Border
                            Padding="8,2"
                            Background="{DynamicResource SemiColorFill0}"
                            CornerRadius="8"
                            IsVisible="{Binding !EnableTun}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource SemiColorText3}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    Text="TUN" />
                            </StackPanel>
                        </Border>
                    </Panel>
                </Button>

                <ComboBox
                    x:Name="cmbRoutings2"
                    Width="140"
                    DisplayMemberBinding="{Binding Remarks}"
                    ItemsSource="{Binding RoutingItems}"
                    ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />
            </StackPanel>

            <ComboBox
                x:Name="cmbSystemProxy"
                Width="140"
                Margin="{StaticResource MarginLr8}"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                IsVisible="{Binding !EnableTun}"
                ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
            </ComboBox>

            <StackPanel Margin="{StaticResource MarginLr8}" VerticalAlignment="Center">
                <ToolTip.Tip>
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding RunningServerToolTipText}" />
                        <TextBlock FontSize="11" Text="{Binding InboundDisplay}" />
                        <TextBlock FontSize="11" Text="{Binding InboundLanDisplay}" />
                    </StackPanel>
                </ToolTip.Tip>
                <TextBlock x:Name="txtRunningServerDisplay" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="txtRunningInfoDisplay"
                    FontSize="11"
                    IsVisible="{Binding BlRunningInfoVisible}"
                    Opacity="0.7"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
