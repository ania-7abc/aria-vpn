<Window
    x:Class="v2rayN.Desktop.Views.AutoSelectSettingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.AutoSelectTitle}"
    Width="560"
    Height="640"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    x:DataType="vms:AutoSelectSettingViewModel"
    mc:Ignorable="d">
    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,6,12,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                MinWidth="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True" />
            <Button
                x:Name="btnCancel"
                MinWidth="100"
                Margin="{StaticResource MarginLr8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Margin4}" Spacing="10">

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{x:Static resx:ResUI.AutoSelectSectionSchedule}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvEnabled}" />
                            <ToggleSwitch
                                x:Name="togEnabled"
                                Grid.Column="1" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvContinuous}" />
                            <ToggleSwitch
                                x:Name="togContinuous"
                                Grid.Column="1" />
                        </Grid>
                        <TextBlock Classes="hint" Text="{x:Static resx:ResUI.AutoSelectContinuousTip}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvContinuousInterval}" />
                            <ComboBox
                                x:Name="cmbContinuousInterval"
                                Grid.Column="1"
                                Width="150"
                                DisplayMemberBinding="{Binding Name}"
                                ItemsSource="{Binding ContinuousIntervalItems}"
                                SelectedItem="{Binding SelectedContinuousInterval}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvInterval}" />
                            <ComboBox
                                x:Name="cmbInterval"
                                Grid.Column="1"
                                Width="150"
                                DisplayMemberBinding="{Binding Name}"
                                ItemsSource="{Binding IntervalItems}"
                                SelectedItem="{Binding SelectedInterval}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvSelectOnStartup}" />
                            <ToggleSwitch
                                x:Name="togSelectOnStartup"
                                Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{x:Static resx:ResUI.AutoSelectSectionSelection}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvStrategy}" />
                            <ComboBox
                                x:Name="cmbStrategy"
                                Grid.Column="1"
                                Width="220"
                                DisplayMemberBinding="{Binding Name}"
                                ItemsSource="{Binding StrategyItems}"
                                SelectedItem="{Binding SelectedStrategy}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvOnlySwitchIfBetter}" />
                            <ToggleSwitch
                                x:Name="togOnlySwitchIfBetter"
                                Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="{x:Static resx:ResUI.AutoSelectSectionLimits}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvTestType}" />
                            <ComboBox
                                x:Name="cmbTestType"
                                Grid.Column="1"
                                Width="220"
                                DisplayMemberBinding="{Binding Name}"
                                ItemsSource="{Binding TestTypeItems}"
                                SelectedItem="{Binding SelectedTestType}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvMaxDelay}" />
                            <NumericUpDown
                                x:Name="numMaxDelay"
                                Grid.Column="1"
                                Width="150"
                                FormatString="0"
                                Increment="10"
                                Maximum="60000"
                                Minimum="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvSwitchTolerance}" />
                            <NumericUpDown
                                x:Name="numSwitchTolerance"
                                Grid.Column="1"
                                Width="150"
                                FormatString="0"
                                Increment="5"
                                Maximum="60000"
                                Minimum="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Classes="label"
                                Text="{x:Static resx:ResUI.AutoSelectLvAllSubscriptions}" />
                            <ToggleSwitch
                                x:Name="togAllSubscriptions"
                                Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
