<UserControl
    x:Class="v2rayN.Desktop.Views.SudoPasswordInputView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    Width="440"
    mc:Ignorable="d">
    <StackPanel Margin="8" Spacing="18">
        <Grid ColumnDefinitions="Auto,*">
            <Border
                Width="48"
                Height="48"
                VerticalAlignment="Top"
                Background="{DynamicResource SemiColorPrimaryLight}"
                CornerRadius="14">
                <PathIcon
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="{StaticResource AriaIconLock}"
                    Foreground="{DynamicResource SemiColorPrimary}" />
            </Border>

            <StackPanel
                Grid.Column="1"
                Margin="14,0,0,0"
                VerticalAlignment="Center"
                Spacing="3">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.SudoDialogTitle}" />
                <TextBlock
                    MaxWidth="330"
                    FontSize="12"
                    Foreground="{DynamicResource SemiColorText2}"
                    Text="{x:Static resx:ResUI.SudoDialogDescription}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="6" Margin="0,2,0,0">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource SemiColorText1}"
                Text="{x:Static resx:ResUI.SudoDialogPassword}" />
            <TextBox
                x:Name="txtPassword"
                Height="40"
                Margin="0,2,0,0"
                VerticalContentAlignment="Center"
                Classes="revealPasswordButton"
                PasswordChar="●"
                PlaceholderText="{x:Static resx:ResUI.SudoDialogPassword}"
                RevealPassword="False" />
            <TextBlock
                x:Name="txtError"
                FontSize="12"
                Foreground="{DynamicResource SemiColorDanger}"
                IsVisible="False"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="btnCancel"
                MinWidth="96"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="True" />
            <Button
                x:Name="btnSave"
                MinWidth="96"
                Content="{x:Static resx:ResUI.SudoDialogUnlock}"
                IsDefault="True"
                Theme="{DynamicResource SolidButton}" />
        </StackPanel>
    </StackPanel>
</UserControl>
