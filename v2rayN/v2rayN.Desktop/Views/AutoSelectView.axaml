<UserControl
    x:Class="v2rayN.Desktop.Views.AutoSelectView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="60"
    d:DesignWidth="460"
    x:DataType="vms:AutoSelectViewModel"
    mc:Ignorable="d">

    <Border
        Margin="0,0,8,0"
        Padding="12,6"
        VerticalAlignment="Center"
        Theme="{DynamicResource CardBorder}">
        <StackPanel Orientation="Horizontal" Spacing="10">

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                VerticalAlignment="Center">
                <PathIcon
                    VerticalAlignment="Center"
                    Data="{StaticResource SemiIconBolt}"
                    Foreground="{DynamicResource ButtonDefaultSuccessForeground}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.AutoSelectTitle}" />
                <ToggleSwitch
                    x:Name="togEnabled"
                    VerticalAlignment="Center"
                    Theme="{DynamicResource SimpleToggleSwitch}" />
            </StackPanel>

            <Border
                Width="1"
                Margin="0,4"
                Background="{DynamicResource ButtonDefaultBorderBrush}" />

            <StackPanel
                MinWidth="150"
                MaxWidth="260"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="txtStatus"
                    FontSize="11"
                    Opacity="0.75"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="txtCurrentServer"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentServerText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                x:Name="btnSelectBest"
                VerticalAlignment="Center"
                Classes="Success"
                Content="{x:Static resx:ResUI.AutoSelectSelectNow}" />

            <Button
                x:Name="btnSetting"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="{x:Static resx:ResUI.AutoSelectTitle}">
                <Button.Content>
                    <PathIcon Data="{StaticResource SemiIconSetting}" />
                </Button.Content>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
