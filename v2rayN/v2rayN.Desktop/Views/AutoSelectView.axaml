<UserControl
    x:Class="v2rayN.Desktop.Views.AutoSelectView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="60"
    d:DesignWidth="500"
    x:DataType="vms:AutoSelectViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="Ellipse.statusDot">
            <Setter Property="Fill" Value="{DynamicResource SemiColorText3}" />
        </Style>
        <Style Selector="Ellipse.statusDot.active">
            <Setter Property="Fill" Value="{DynamicResource SemiColorSuccess}" />
        </Style>
    </UserControl.Styles>

    <Border
        Padding="12,6"
        VerticalAlignment="Center"
        Classes="card">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <PathIcon
                    VerticalAlignment="Center"
                    Data="{StaticResource SemiIconBolt}"
                    Foreground="{DynamicResource SemiColorPrimary}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{x:Static resx:ResUI.AutoSelectTitle}" />
                <ToggleSwitch
                    x:Name="togEnabled"
                    VerticalAlignment="Center"
                    Theme="{DynamicResource SimpleToggleSwitch}" />
            </StackPanel>

            <StackPanel
                MinWidth="150"
                MaxWidth="260"
                VerticalAlignment="Center"
                Spacing="1">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Ellipse
                        Width="7"
                        Height="7"
                        VerticalAlignment="Center"
                        Classes.active="{Binding Enabled}"
                        Classes="statusDot" />
                    <TextBlock
                        x:Name="txtStatus"
                        FontSize="11"
                        Opacity="0.75"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="txtCurrentServer"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentServerText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                x:Name="btnSelectBest"
                VerticalAlignment="Center"
                Classes="Success"
                Content="{x:Static resx:ResUI.AutoSelectSelectNow}"
                IsEnabled="{Binding !IsBusy}" />
            <Button
                x:Name="btnSetting"
                VerticalAlignment="Center"
                Classes="IconButton"
                ToolTip.Tip="{x:Static resx:ResUI.AutoSelectMenu}">
                <Button.Content>
                    <PathIcon Data="{StaticResource SemiIconSetting}" />
                </Button.Content>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
